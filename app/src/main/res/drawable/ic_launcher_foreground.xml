<?xml version="1.0" encoding="utf-8"?>
<!-- Appikonen "Bladet" (DSN-7): ett pappersark med tre textrader och en solgul trendkurva,
     och Kodhästs två solgula prickar uppe till vänster. 108 × 108 med motivet inom den säkra zonen (cirkeln med diameter 66 i mitten).
     Färgerna är resurser i values/colors.xml som speglar AppColors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bladet skalat 0,8 kring nederkanten och flyttat något ner åt höger, så att prickarna får plats. -->
    <group
        android:pivotX="54"
        android:pivotY="86"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateX="5"
        android:translateY="1">
        <path
            android:pathData="M40,22h28a10,10 0 0,1 10,10v44a10,10 0 0,1 -10,10h-28a10,10 0 0,1 -10,-10v-44a10,10 0 0,1 10,-10z"
            android:fillColor="@color/ic_launcher_paper" />
        <path
            android:pathData="M40,40h28M40,50h18M40,60h22"
            android:strokeColor="@color/ic_launcher_lines"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M38,78c8,-2 12,-12 18,-12s8,6 16,-8"
            android:fillColor="#00000000"
            android:strokeColor="@color/ic_launcher_sun"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

    </group>
    <!-- Kodhästs två prickar uppe till vänster (DSN-7). Ytterkanten 32,9 från mitten, inom säkra zonen (33). -->
    <path
        android:pathData="M32.7,31a4.3,4.3 0 1,0 8.6,0a4.3,4.3 0 1,0 -8.6,0zM45.2,31a4.3,4.3 0 1,0 8.6,0a4.3,4.3 0 1,0 -8.6,0z"
        android:fillColor="@color/ic_launcher_sun" />
</vector>
