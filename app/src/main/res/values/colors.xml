<?xml version="1.0" encoding="utf-8"?>
<!-- Fönstrets och startskärmens bakgrund: temats background (dimma) i ui/theme/AppColors.
     Resurser måste vara XML; AppIconTest håller dem lika med temat. -->
<resources>
    <color name="window_background">#F2F5F5</color>

    <!-- Appikonen "Bladet" (DSN-7). Speglar AppColors.light: teal = primary, dimma = background,
         solgul = secondary – AppIconTest håller dem lika. Radernas grå finns bara i ikonen. -->
    <color name="ic_launcher_background">#0B6E66</color>
    <color name="ic_launcher_paper">#F2F5F5</color>
    <color name="ic_launcher_sun">#F5B631</color>
    <color name="ic_launcher_lines">#C9C2B4</color>

    <!-- Kodhästs ordmärke på startskärmen (NFR-5, android-ui:s kodhast_branding): ersätter bibliotekets
         färger med temats onSurfaceVariant (texten) och primary (prickarna). AppIconTest håller dem lika. -->
    <color name="kodhast_branding_text">#5E6866</color>
    <color name="kodhast_branding_dots">#0B6E66</color>
</resources>
