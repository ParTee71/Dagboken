<?xml version="1.0" encoding="utf-8"?>
<!-- Fönstrets och startskärmens bakgrund: temats background (papper) i ui/theme/AppColors.
     Resurser måste vara XML; AppIconTest håller dem lika med temat. -->
<resources>
    <color name="window_background">#FBF7EE</color>

    <!-- Appikonen "Bladet" (DSN-7). Speglar AppColors.light: teal = primary, papper = background,
         solgul = secondary – AppIconTest håller dem lika. Radernas grå finns bara i ikonen. -->
    <color name="ic_launcher_background">#0B6E66</color>
    <color name="ic_launcher_paper">#FBF7EE</color>
    <color name="ic_launcher_sun">#F5B631</color>
    <color name="ic_launcher_lines">#C9C2B4</color>
</resources>
